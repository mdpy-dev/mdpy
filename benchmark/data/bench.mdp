; GROMACS MDP for pure nonbonded benchmark
; Minimal bonded interactions, focus on nonbonded GPU performance
integrator          = md
dt                  = 0.002
nsteps              = 3000
nstenergy           = 0
nstlog              = 0
nstxout             = 0
nstvout             = 0
nstfout             = 0

; Nonbonded settings matching OpenMM (PME, 1.2nm cutoff)
cutoff-scheme       = Verlet
ns_type             = grid
nstlist             = 20
rlist               = 1.3
coulombtype         = PME
rcoulomb             = 1.2
vdwtype             = Cut-off
rvdw                 = 1.2
pbc                 = xyz

; Constraints (match OpenMM HBonds)
constraints         = h-bonds
constraint-algorithm = LINCS

; Temperature coupling (minimal, just to keep stable)
tcoupl              = V-rescale
tc-grps             = System
tau_t               = 0.1
ref_t               = 300

; Pressure coupling off
pcoupl              = no
